# The template. Copy to .env for local development only.
#
# .env is gitignored and is never read in staging or production: those set real
# environment variables. The service must be able to start with no file present
# but its environment set -- if that stops being true, something has grown a
# dependency on a file that will not exist in the container.

# ── required: no default is provided for any of these ────────────────────
EBPCO_ENVIRONMENT=development

# A default here would be a service that starts successfully while talking to
# the wrong thing.
DATABASE_URL=postgres://ebpco:ebpco@localhost:5432/ebpco
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=ebpco-documents
MALWARE_SCANNER_URL=http://localhost:3310

# Security-critical, and treated exactly like a backing service: no default. A
# signing key with a fallback is the same key in every deployment that forgot to
# set one, and anyone who has read the source can then mint a token for any
# account. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=development-only-signing-key-not-for-any-real-deployment

# Mixed into every password verifier and held OUTSIDE the database, so a
# database-only leak (the common case, via backup or injection) does not yield
# crackable verifiers. Required outside development; boot fails without it.
PASSWORD_PEPPER=development-only-pepper-not-for-any-real-deployment

# Encrypts every enrolled TOTP secret at rest. Required outside development --
# boot fails if it is shorter than 32 characters -- and MISSING FROM THIS FILE
# until 2026-08-30, which meant an operator following the template got a service
# that started locally and refused to start in staging, naming a variable the
# template had never mentioned. Generate with: openssl rand -base64 48
TOTP_ENCRYPTION_KEY=development-only-totp-key-not-for-any-real-deployment

# ── optional: shown with their defaults ──────────────────────────────────
PORT=3000
LOG_LEVEL=info

REQUEST_TIMEOUT_MS=20000
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Only true behind a proxy known to set X-Forwarded-For. Trusting it without
# one lets a caller forge their source address and walk around rate limiting.
TRUST_PROXY=false

# Rejected at boot if true while EBPCO_ENVIRONMENT=production.
DOCS_ENABLED=false

# How long an access token lives. The 900-second ceiling is a security property
# and is enforced, not advisory.
ACCESS_TOKEN_TTL_SECONDS=900

# Connection pool, tuned against the deployment: too many replicas against one
# small managed Postgres exhausts its connection limit, and too few queues
# requests behind each other.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# Off by default. Exactly one deployment should run the schedulers; several
# replicas each running them multiply every swept notice by the replica count.
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=15

# Unset means documents are never purged on a schedule. A number here is a
# retention decision, so there is deliberately no default.
# DOCUMENT_RETENTION_DAYS=

# Where the local object store writes when one is used instead of S3.
OBJECT_STORE_LOCAL_PATH=.data/objects

# Draining, then the hard deadline. SHUTDOWN_DRAIN_MS is how long the instance
# reports itself out of rotation while still serving in-flight requests -- it
# must exceed the load balancer's health-check interval or the balancer will
# still be sending traffic when the process stops accepting it.
SHUTDOWN_DRAIN_MS=12000
SHUTDOWN_DEADLINE_MS=20000

# Injected by the build, not set by hand.
# BUILD_COMMIT=
# BUILD_TIME=
CONTRACT_VERSION=0.1.0
