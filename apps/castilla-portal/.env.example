# Copy to .env (or set these directly in the process manager / systemd unit)
# before running `npm run build && npm start`. main.ts fails fast at boot if
# DATABASE_URL is unset.

# Postgres connection string. Required.
DATABASE_URL=postgres://user:password@localhost:5432/castilla_portal

# Port the API listens on (0.0.0.0). Optional — defaults to 3000.
PORT=3000

# Comma-separated extra origins allowed to call this API via CORS, on top of
# the two production hosts main.ts always allows
# (https://castilla-ebpco.online, https://www.castilla-ebpco.online).
# Useful for a Netlify deploy-preview URL or a local dev frontend. Optional.
# ALLOWED_ORIGINS=http://localhost:4200,https://deploy-preview-42--castilla-ebpco.netlify.app
