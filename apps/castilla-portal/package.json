{
  "name": "castilla-portal-api",
  "version": "0.1.0",
  "private": true,
  "description": "API for the Municipality of Castilla public information portal",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts test --max-warnings 0",
    "extract:portal": "ts-node --transpile-only scripts/extract-portal-data.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js",
    "verify": "npm run typecheck && npm run lint && npm run contract:check && npm run vocabulary:check && npm run test",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "contract:emit": "ts-node --transpile-only scripts/emit-openapi.ts",
    "contract:check": "ts-node --transpile-only scripts/emit-openapi.ts --check",
    "vocabulary:sync": "ts-node --transpile-only scripts/sync-permit-vocabulary.ts",
    "vocabulary:check": "ts-node --transpile-only scripts/sync-permit-vocabulary.ts --check",
    "forms:import": "ts-node --transpile-only scripts/import-forms.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  }
}
