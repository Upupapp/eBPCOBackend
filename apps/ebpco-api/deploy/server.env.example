# The API's environment. Copy to /opt/ebpco/server.env, chmod 600, fill in
# every blank. Key order and names mirror the live file so `diff` between the
# two is meaningful. See ../.env.example for what each setting means.
#
# Do NOT blank a value to "unset" it: the validator treats an empty LOG_LEVEL
# or BUILD_TIME as an error, not an absence, and the service exits 78 at boot.

# `staging` today: the local signature scanner below is not accepted by
# `production`, which needs clamd (see README §Upgrading to production).
EBPCO_ENVIRONMENT=staging
PORT=3000

# Compose network addresses. `postgres` and `minio` are the service names.
DATABASE_URL=postgres://ebpco:<POSTGRES_PASSWORD from infra.env>@postgres:5432/ebpco
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# Documents go to MinIO over the compose network via the S3 driver.
OBJECT_STORE_DRIVER=s3
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=ebpco-documents
OBJECT_STORE_REGION=us-east-1
# MinIO credentials, read by the AWS SDK's default chain.
AWS_ACCESS_KEY_ID=ebpco-minio
AWS_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD from infra.env>
# Anonymous-read probe. MinIO's bucket is private, so this must FAIL for
# readiness to report the store as up.
OBJECT_STORE_PUBLIC_PROBE_URL=http://minio:9000

MALWARE_SCANNER_DRIVER=local
MALWARE_SCANNER_URL=http://localhost:3310

# Four secrets, each ≥ 32 characters, each different: openssl rand -base64 48
# Back them up off-host. Losing TOTP_ENCRYPTION_KEY locks out every officer
# with an enrolled second factor; losing PASSWORD_PEPPER invalidates every
# password.
JWT_SIGNING_KEY=
PASSWORD_PEPPER=
TOTP_ENCRYPTION_KEY=
PUSH_TOKEN_ENCRYPTION_KEY=
# Firebase Cloud Messaging: the castilla-ebpco service-account JSON, base64 on one
# line (Firebase console > Project settings > Service accounts > Generate new
# private key; then `base64 -w0 key.json`). Unset = push is queued, not sent.
FCM_SERVICE_ACCOUNT_JSON_BASE64=
# Periodic jobs (push dispatch, data exports, retention, overdue sweep). Off by
# default; individual jobs can be switched off in the scheduled_jobs table.
SCHEDULER_ENABLED=false

# The two portals' origins. Also the CORS allowlist — a portal not listed
# here fails every request in the browser console and logs nothing here.
# Change these when the real domain (admin./citizen.castilla-ebpco.online)
# resolves and the portals move to it.
PORTAL_BASE_URL=https://ebpcowebadmin.netlify.app
USER_PORTAL_BASE_URL=https://fastidious-chimera-7a7a18.netlify.app

DOCS_ENABLED=false
LOG_LEVEL=info
# Caddy is the only thing that should reach :3000 and it sets X-Forwarded-For.
TRUST_PROXY=true
