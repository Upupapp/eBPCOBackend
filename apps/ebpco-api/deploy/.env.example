# The deployment's environment. Copy to deploy/.env on the HOST, fill in every
# value marked CHANGE, and never commit the copy (.gitignore already refuses
# `.env`; this template is the one exception).
#
# One file, two readers: Compose substitutes `${...}` in docker-compose.yml
# from it, and the `api`/`migrate` containers receive it whole as their
# environment. DATABASE_URL, PORT, TRUST_PROXY, OBJECT_STORE_LOCAL_PATH and
# MALWARE_SCANNER_URL are set IN the compose file because they describe the
# compose network, not the deployment — do not add them here.
#
# Every value below is either filled or a valid default. Do NOT blank a
# value to "unset" it: the validator treats an empty LOG_LEVEL or BUILD_TIME
# as an error, not an absence, and the service exits 78 at boot. Delete the
# line instead.

# ── this host ──────────────────────────────────────────────────────────────
# The public hostname the API answers on. Caddy issues a certificate for it,
# so it must already resolve to this machine. No scheme, no path.
#
# Without a domain, use sslip.io: `<ip-with-dashes>.sslip.io` resolves to that
# IP with no DNS to configure (172.105.1.2 → 172-105-1-2.sslip.io), and
# Let's Encrypt issues for it. Swap in a real hostname when the LGU has one —
# then also change EBPCO_API_BASE_URL in both portals' netlify.toml.
# CHANGE:
API_HOST=172-105-1-2.sslip.io

# Postgres superuser password for the `ebpco` database, used only inside the
# compose network. Generate: openssl rand -base64 32
# CHANGE:
POSTGRES_PASSWORD=

# ── which environment this is ──────────────────────────────────────────────
# `staging` boots on the filesystem object store and the local scanner
# (below). `production` REFUSES both (app-config.ts) and needs an
# S3-compatible bucket plus clamd — see README §Upgrading to production.
# Staging never holds real applicant data (docs/ENVIRONMENTS.md).
EBPCO_ENVIRONMENT=staging
LOG_LEVEL=info

# ── secrets: four of them, each ≥ 32 characters, each DIFFERENT ────────────
# Generate each one separately:  openssl rand -base64 48
# Rotating JWT_SIGNING_KEY signs everyone out. Rotating PASSWORD_PEPPER
# invalidates every password. Rotating TOTP_ENCRYPTION_KEY loses every
# enrolled second factor. Treat all four as backups treat the database.
# CHANGE:
JWT_SIGNING_KEY=
# CHANGE:
PASSWORD_PEPPER=
# CHANGE:
TOTP_ENCRYPTION_KEY=
# CHANGE:
PUSH_TOKEN_ENCRYPTION_KEY=

# ── the two portals, exactly as a browser sees them ────────────────────────
# Origins, so scheme + host, no trailing slash. These are BOTH the base for
# links in emails AND the CORS allowlist (security.ts): a portal whose real
# origin is not one of these two fails every request with a CORS error in
# the browser console and nothing in this service's logs.
PORTAL_BASE_URL=https://ebpcowebadmin.netlify.app
USER_PORTAL_BASE_URL=https://fastidious-chimera-7a7a18.netlify.app

# ── documents ──────────────────────────────────────────────────────────────
# `filesystem` writes to the `documents` volume on this host: survives
# restarts and rebuilds, does NOT survive losing the host. Production must
# switch to `s3` (Linode Object Storage, ap-south-1 is the nearest region;
# credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, added here).
OBJECT_STORE_DRIVER=filesystem
# Required non-empty by the validator even while unused by `filesystem`.
# Becomes the real bucket endpoint/name the moment the driver is `s3`.
OBJECT_STORE_ENDPOINT=https://unused-while-driver-is-filesystem.invalid
OBJECT_STORE_BUCKET=ebpco-documents
# OBJECT_STORE_REGION=ap-south-1
# OBJECT_STORE_PUBLIC_PROBE_URL=

# ── upload scanning ────────────────────────────────────────────────────────
# `local` recognises EICAR and a few executable headers and nothing else.
# `clamav` speaks to the compose file's clamav service; start it with
# `docker compose --profile production up -d`.
MALWARE_SCANNER_DRIVER=local

# ── email ──────────────────────────────────────────────────────────────────
# `console` prints password-reset mail to `docker compose logs api` instead
# of sending it. Set `smtp` and the four SMTP_* values to deliver for real.
MAIL_DRIVER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=E-BPCO <no-reply@castilla.gov.ph>

# ── behaviour ──────────────────────────────────────────────────────────────
# Exactly ONE deployment may run the schedulers (each replica would multiply
# every swept notice). This compose stack is one replica, so it is that one.
SCHEDULER_ENABLED=true
# Unset means documents are never purged on a schedule; a number here is a
# retention decision for the LGU, not a default.
# DOCUMENT_RETENTION_DAYS=
DOCS_ENABLED=false
ACCESS_TOKEN_TTL_SECONDS=900
DB_POOL_MAX=10
CONTRACT_VERSION=0.1.0
