# The real domain. Its DNS still points at a parking address (198.54.117.242,
# 2026-09-19), so Caddy cannot obtain a certificate for it yet; it keeps
# retrying in the background and will start serving the moment the A record
# points here. Until then the sslip.io name below is what the portals use.
api.castilla-ebpco.online {
	reverse_proxy ebpco-api:3000
}

# Wildcard DNS that needs no registrar: the host IP spelled with dashes.
# Let's Encrypt issues for it. Both Netlify portals are built with
# EBPCO_API_BASE_URL=https://139-162-51-165.sslip.io (their netlify.toml).
139-162-51-165.sslip.io {
	reverse_proxy ebpco-api:3000
}
