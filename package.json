{
  "name": "ebpco-api",
  "version": "0.1.0",
  "private": true,
  "description": "The eBPCO backend of record.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts --max-warnings 0",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js",
    "test:cov": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "emit:catalog": "ts-node --transpile-only scripts/emit-notification-catalog.ts",
    "emit:samples": "ts-node --transpile-only scripts/emit-response-samples.ts",
    "audit:reachability": "ts-node --transpile-only scripts/reachability.ts",
    "audit:samples": "ts-node --transpile-only scripts/sample-coverage.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "fastify": "5.11.3",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
